      "mode": "viewport-filling",
      "height": "100dvh",
      "width": "100%",
      "tube": "flex: 1; min-height: 0; aspect-ratio: auto",
      "storyZoom": false,
      "roomFurniture": "hidden"
    }
  },
  "components": [
    {
      "name": "Molded channel key",
      "kind": "button",
      "refersTo": "hardware-key",
      "description": "A physical channel key beneath the glass.",
      "html": "<button class=\"ds-hardware-key\" aria-label=\"Next channel\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-hardware-key{display:grid;place-items:center;width:44px;height:44px;background:linear-gradient(145deg,#e7e0cc,#c1b89e);color:#4d5142;border:0;border-radius:7px;cursor:pointer;box-shadow:0 3px 3px #5b543c66,0 1px 0 #6d664f,inset 0 1px 1px #fff,inset 0 -2px 2px #8e84633b}.ds-hardware-key:hover{filter:brightness(1.03)}.ds-hardware-key:active{box-shadow:0 1px 2px #5b543c66,inset 0 1px 2px #817b5d44}.ds-hardware-key:focus-visible{outline:2px solid #2b4a30;outline-offset:4px}"
    },
    {
      "name": "Olive power switch",
      "kind": "button",
      "refersTo": "power-button",
      "description": "A round raised switch with a physical power symbol.",
      "html": "<button class=\"ds-power-button\" aria-label=\"Power\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 2v10M6.3 5.6a9 9 0 1 0 11.4 0\"/></svg></button>",
      "css": ".ds-power-button{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:linear-gradient(145deg,#87916a,#5c684b);color:#d4dcc0;border:1px solid #626e50;cursor:pointer;box-shadow:0 3px 4px #403e2e99,inset 0 1px 2px #d2d4a999,inset 0 -2px 3px #34462e6b}.ds-power-button:hover{filter:brightness(1.03)}.ds-power-button:focus-visible{outline:2px solid #2b4a30;outline-offset:4px}"
    },
    {
      "name": "Two-column channel menu",
      "kind": "nav",
      "refersTo": "channel-menu",
      "description": "Numbered terminal buttons with inverse hover and visible keyboard focus.",
      "html": "<nav class=\"ds-channel-menu\" aria-label=\"Channels\"><button><span>01</span> About the human</button><button><span>02</span> Work</button><button><span>03</span> Tools &amp; skills</button><button><span>04</span> The journey</button></nav>",
      "css": ".ds-channel-menu{display:grid;grid-template-columns:1fr 1fr;gap:0 14px;background:var(--bg,#0e1210);padding:12px}.ds-channel-menu button{font-family:\"IBM Plex Mono\",monospace;border:0;border-radius:0;background:none;color:var(--accent,#6dff9c);cursor:pointer;text-align:left;transition:background .12s,color .12s;display:flex;gap:7px;align-items:center;min-height:28px;font-size:11px;line-height:1.5;padding:3px 2px}.ds-channel-menu button span{color:var(--dim,#b0b9aa)}.ds-channel-menu button:hover{color:var(--bg,#0e1210);background:var(--accent,#6dff9c)}.ds-channel-menu button:focus-visible{outline:2px solid var(--accent,#6dff9c);outline-offset:2px;}"
    },
    {
      "name": "Transmission launcher",
      "kind": "button",
      "refersTo": "story-invitation",
      "description": "A bordered screen invitation to the seven-chapter personal transmission.",
      "html": "<button class=\"ds-story-invitation\"><span>There is a story<br>behind the signal.</span><strong><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M5 3 21 12 5 21Z\"/></svg> PLAY TRANSMISSION</strong><small>7 CHAPTERS / ABOUT 2 MIN</small></button>",
      "css": ".ds-story-invitation{font-family:\"IBM Plex Mono\",monospace;border:0;border-radius:0;background:none;color:var(--accent,#6dff9c);cursor:pointer;text-align:left;transition:background .12s,color .12s;display:flex;flex-direction:column;align-items:flex-start;gap:5px;position:relative;border:1px solid color-mix(in srgb,var(--accent,#6dff9c) 30%,transparent);padding:10px;font-size:10px}.ds-story-invitation>span{color:var(--dim,#b0b9aa);font-size:9px;line-height:1.6}.ds-story-invitation strong{display:flex;align-items:center;gap:5px;font-size:10px;font-weight:500;margin-top:1px}.ds-story-invitation small{color:var(--dim,#b0b9aa);font-size:8px}.ds-story-invitation:hover,.ds-story-invitation:hover *{background:var(--accent,#6dff9c);color:var(--bg,#0e1210)}.ds-story-invitation:focus-visible{outline:2px solid var(--accent,#6dff9c);outline-offset:2px;}"
    },
    {
      "name": "Terminal return-address field",
      "kind": "input",
      "refersTo": "terminal-field",
      "description": "An explicitly labeled square field with a phosphor bottom rule.",
      "html": "<label class=\"ds-field-label\">02 / RETURN ADDRESS<input class=\"ds-field\" type=\"email\" autocomplete=\"email\" required placeholder=\"you@somewhere.good\"></label>",
      "css": ".ds-field-label{font-family:\"IBM Plex Mono\",monospace;font-size:10px;color:var(--secondary,#ffb347);letter-spacing:.04em}.ds-field{display:block;width:100%;min-height:44px;background:color-mix(in srgb,var(--accent,#6dff9c) 3%,var(--bg,#0e1210));color:var(--phosphor,#efe9d8);border:0;border-bottom:1px solid color-mix(in srgb,var(--accent,#6dff9c) 40%,transparent);border-radius:0;margin-top:7px;padding:10px;font-family:\"IBM Plex Mono\",monospace;font-size:1.35em;line-height:1.7;caret-color:var(--accent,#6dff9c)}.ds-field::placeholder{color:var(--dim,#b0b9aa);opacity:1}.ds-field:focus-visible{outline:2px solid var(--accent,#6dff9c);outline-offset:2px;}"
    },
    {
      "name": "Selected project row",
      "kind": "button",
      "refersTo": "project-row-selected",
      "description": "The active project uses a solid inverse selection bar.",
      "html": "<button class=\"ds-project-row\" role=\"tab\" aria-selected=\"true\"><span>01</span><span>SELECTED PROJECT</span><small>VIEW</small></button>",
      "css": ".ds-project-row{font-family:\"IBM Plex Mono\",monospace;border:0;border-radius:0;background:none;color:var(--accent,#6dff9c);cursor:pointer;text-align:left;transition:background .12s,color .12s;display:flex;align-items:center;gap:8px;padding:10px 7px;font-size:11px;line-height:1.6;background:var(--accent,#6dff9c);color:var(--bg,#0e1210)}.ds-project-row>span:nth-child(2){flex:1}.ds-project-row>span:first-child{font-size:.8em}.ds-project-row small{font-size:.75em}.ds-project-row:hover{background:var(--accent,#6dff9c);color:var(--bg,#0e1210)}.ds-project-row:focus-visible{outline:2px solid var(--accent,#6dff9c);outline-offset:2px;}"
    },
    {
      "name": "Phosphor OSD",
      "kind": "custom",
      "refersTo": "status-overlay",
      "description": "A transient pixel-font status announcement over the glass.",
      "html": "<div class=\"ds-osd\" role=\"status\" aria-live=\"polite\">CH 01 / HOME</div>",
      "css": ".ds-osd{font-family:\"Silkscreen\",monospace;color:#6dff9c;text-shadow:1px 1px #061309,-1px -1px #061309,0 0 5px #000;font-size:11px;text-align:right;background:#0a110bba;padding:4px 6px;max-width:85%;pointer-events:none}"
    }
  ],
  "narrative": {
    "northStar": "The Personal Signal",
    "overview": "A warm, aged plastic CRT sits on a dark desk. The machine is the portfolio: its curved glass contains a working teletext and BBS interface, while the molded controls remain outside the picture. Hardware feels used and tactile; screen content feels numbered, deliberate and alive.\n\nThe user-supplied SA-01 brief fixes this world. CSS materials, ordinary React content and synthesized opt-in audio carry the experience. The same machine remains visible on phones, with a compact first Home frame and internally scrolling reading surfaces.",
    "keyCharacteristics": [
      "Aged plastic, recessed seams, a dark gasket and curved reflective glass.",
      "Phosphor typography, numbered channels and inverse selection bars.",
      "Physical controls and an always-visible sound grille.",
      "Optional sound, plain reading mode and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Chassis Rule",
        "body": "Colour mode changes the picture and its emitted light; it does not recolor the plastic chassis.",
        "section": "colors"
      },
      {
        "name": "The Readable Signal Rule",
        "body": "Effects must yield to plain reading mode and reduced-motion preferences.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep physical controls beneath the glass and the sound grille visible at every breakpoint.",
      "**Do** keep Home navigation in two columns and the transmission launcher reachable in its first compact frame.",
      "**Do** use inverse phosphor selection for interactive screen states and preserve visible keyboard focus.",
      "**Do** preserve plain mode, reduced motion, text-only storytelling and muted-by-default sound.",
      "**Do** draw hardware and story materials in code and keep prose selectable, semantic and scrollable."
    ],
    "donts": [
      "**Don't** recolor the molded chassis when changing screen colour modes.",
      "**Don't** let decorative CRT layers intercept clicks or obscure reading controls.",
      "**Don't** reintroduce story scenes, random jitter or static bursts into text-only storytelling.",
      "**Don't** treat the compact Home menu as a generic spacious card grid."
    ]
  }
}
